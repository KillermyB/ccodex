{
  "name": "@gkorepanov/ccodex",
  "version": "0.7.0-personal.3",
  "description": "Unofficial macOS fork of ccodex with personal/project modes, native Claude tools and inline animation previews.",
  "homepage": "https://github.com/KillermyB/ccodex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KillermyB/ccodex.git"
  },
  "bugs": {
    "url": "https://github.com/KillermyB/ccodex/issues"
  },
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "ccodex": "./dist/cli/main.js"
  },
  "engines": {
    "node": ">=22.13 <27"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "README.md",
    "scripts/install.sh",
    "scripts/uninstall.sh",
    "scripts/install-claude-stack.sh",
    "agents/*.md",
    "instructions/*.md",
    "examples/config.toml",
    "legal/LICENSES.md",
    "legal/THIRD_PARTY_NOTICES.md",
    "config/compatibility.json",
    "npm-shrinkwrap.json",
    "SECURITY-CHANGES.txt"
  ],
  "scripts": {
    "build": "npm run build:ts",
    "clean:dist": "rm -rf dist",
    "build:ts": "npm run clean:dist && tsc -p config/tsconfig.build.json",
    "check": "tsc -p config/tsconfig.build.json --noEmit",
    "check:public-tree": "node scripts/check-public-tree.mjs",
    "dev": "tsx src/cli/main.ts",
    "test": "npm run build:ts && npm run test:security",
    "test:unit": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:security": "npm run build:tests && node --experimental-test-module-mocks --test tests/security/*.test.mjs",
    "build:tests": "tsc tests/fixtures/fakeClaude.ts --outDir test-generated --target ES2023 --module ESNext --moduleResolution Bundler --skipLibCheck",
    "build:relay": "sh scripts/build-relay.sh",
    "build:relay:linux": "sh scripts/build-linux-relay.sh",
    "sync:relay-transport": "node scripts/relay-transport.mjs",
    "check:relay-transport": "node scripts/relay-transport.mjs --check"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "smol-toml": "1.9.0",
    "uuid": "13.0.2",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@openai/codex": "0.156.0",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "ajv": "8.20.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
